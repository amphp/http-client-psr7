{
    "name": "amphp/http-client-psr7",
    "homepage": "https://github.com/amphp/http-client-psr7",
    "description": "PSR-7 adapter for Amp's HTTP client.",
    "keywords": [
        "http",
        "client",
        "http-client",
        "amphp",
        "async",
        "psr-7",
        "psr-17",
        "psr-18"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Niklas Keller",
            "email": "me@kelunik.com"
        },
        {
            "name": "Aaron Piotrowski",
            "email": "aaron@trowski.com"
        },
        {
            "name": "Edward Surov",
            "email": "zoohie@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "amphp/amp": "^3",
        "amphp/byte-stream": "^2",
        "amphp/http-client": "^5",
        "psr/http-message": "^1.1 || ^2",
        "psr/http-factory": "^1",
        "psr/http-client": "^1",
        "psr/http-factory-implementation": "^1",
        "revolt/event-loop": "^1"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "amphp/php-cs-fixer-config": "^2",
        "phpunit/phpunit": "^9",
        "guzzlehttp/psr7": "^2",
        "psalm/phar": "^5"
    },
    "provide": {
        "psr/http-client-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Amp\\Http\\Client\\Psr7\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amp\\Http\\Client\\Psr7\\": "test"
        }
    }
}
